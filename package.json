{
	"name": "quillify",
	"version": "0.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"assets",
		"NOTICE",
		"licenses"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"gate": "npm run build && npm run lint && npm run check && npm test",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check": "tsc",
		"test": "vitest run",
		"assets": "node scripts/assets.js",
		"build": "npm run assets && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"corpus": "npm run assets && vitest run --config corpus/vitest.config.ts"
	},
	"devDependencies": {
		"@quillmark/wasm": "0.124.0",
		"@types/node": "24.19.0",
		"@vitest/browser-playwright": "5.0.2",
		"playwright": "1.63.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vitest": "5.0.2"
	},
	"dependencies": {
		"@neslinesli93/qpdf-wasm": "0.3.0",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.3.289"
	},
	"peerDependencies": {
		"@quillmark/wasm": ">=0.124.0"
	}
}
